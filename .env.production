# ════════════════════════════════════════════════════════════════
# AI-PECO Frontend Production Environment Configuration
# ════════════════════════════════════════════════════════════════
# 
# Set these environment variables in Vercel deployment settings:
# - VITE_API_URL: Your deployed backend URL (e.g., https://api.render.com)
# - VITE_DEMO_LOGIN: Set to 'true' to enable auto-fallback to demo admin credentials
# ════════════════════════════════════════════════════════════════

# REQUIRED: Backend API URL — must include https:// scheme
# Override this in Vercel Dashboard → Project → Settings → Environment Variables
VITE_API_URL=https://ai-peco-backend.vercel.app

# OPTIONAL: Use demo data for testing (default: false)
VITE_USE_DEMO_DATA=false

# OPTIONAL: Enable demo login with admin@aipeco.com / admin123 (default: false)
# Set to 'true' only for testing purposes, disable in production
VITE_DEMO_LOGIN=false

